# ============================================
PAYPAL_CLIENT_ID=<secret>
PAYPAL_CLIENT_SECRET=<secret>
PAYPAL_MODE=sandbox/live
APP_IDENTIFIER=saleor.app.paypal
# ============================================
# App Configuration
# ============================================
APP_IDENTIFIER=saleor.app.razorpay

# ============================================
# Cloudflare Tunnel (optional)
# Get token: cloudflared tunnel token <TUNNEL-NAME>
# Leave blank if running cloudflared on host instead of Docker
# ============================================
CLOUDFLARE_TUNNEL_TOKEN=

# ============================================
# Optional: Upstash Redis APL
# Use this if you want auth persistence outside the container
# Get free database: https://upstash.com
# ============================================
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
