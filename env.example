# ============================================
# Razorpay Credentials
# Get from: https://dashboard.razorpay.com/app/keys
# ============================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
INTERNAL_API_SECRET=random Hex 32 string (only when api is locked behind cloudflare waf)

# ============================================
# App Configuration
# ============================================
APP_IDENTIFIER=saleor.app.razorpay

# ============================================
# Cloudflare Tunnel (optional)
# Get token: cloudflared tunnel token <TUNNEL-NAME>
# Leave blank if running cloudflared on host instead of Docker
# ============================================
CLOUDFLARE_TUNNEL_TOKEN=

# ============================================
# Optional: Upstash Redis APL
# Use this if you want auth persistence outside the container
# Get free database: https://upstash.com
# ============================================
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
